{
  "name": "coinvault",
  "version": "1.0.0",
  "description": "AI-powered coin identifier and collector app",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "install:all": "npm install && npm install --workspace=server && npm install --workspace=client",
    "seed": "npm run seed --workspace=server",
    "start": "NODE_ENV=production node server/src/app.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
